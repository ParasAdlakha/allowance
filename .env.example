# --- PayPal (sandbox) ---------------------------------------------------
# developer.paypal.com > Apps & Credentials > your app (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
# Optional: force a funding mode: hold | vault | simulated.
# Default: vault if the app can create Vault setup tokens, else hold. No PayPal keys -> simulated.
# PAYMENT_MODE=

# --- Model (any OpenAI-compatible endpoint) -----------------------------
# Gemini (default):
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash
# Free tiers are rate limited; set requests/minute per model:
LLM_RPM=
# Comma-separated models to try when one hits its daily quota:
LLM_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# OpenAI instead: LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-5-mini
# Local Ollama:   LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=qwen2.5:32b  LLM_API_KEY=ollama
# No key at all -> a deterministic, deliberately gullible scripted agent (good for seeing the gate work).

# --- Allowance ----------------------------------------------------------
# HMAC key that signs mandates. Any long random string.
MANDATE_SIGNING_KEY=
PORT=8787
